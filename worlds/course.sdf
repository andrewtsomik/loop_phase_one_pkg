<?xml version="1.0" ?>
<!--
  course.sdf - S1 obstacle course for Gazebo Harmonic (ROS 2 Jazzy)
 
  Layout (meters, top-down, robot starts at origin facing +x):
    - Boundary walls at x = +-10, y = +-10
    - Boulder cylinders (radius 1.5): (3, 0), (-2, 3), (0, -4)
    - Long wall at x = -5 spanning y = -3..3
  Keep OBSTACLES in navigator.py in sync with this file.
 
  Topics (Gazebo side):
    /cmd_vel  gz.msgs.Twist      (in)
    /odom     gz.msgs.Odometry   (out)
    /scan     gz.msgs.LaserScan  (out)
    /clock    gz.msgs.Clock      (out)
-->
<sdf version="1.9">
  <world name="course">
 
    <!-- ================= Simulation settings ================= -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
 
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Required for the lidar to publish anything -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
 
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.9 1</background>
      <grid>true</grid>
    </scene>
 
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
 
    <!-- ================= Ground ================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
 
    <!-- ================= Boundary walls ================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.2 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 1</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      </link>
    </model>
 
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.2 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 1</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      </link>
    </model>
 
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.2 1</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      </link>
    </model>
 
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.2 1</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      </link>
    </model>
 
    <!-- ================= Obstacles ================= -->
    <model name="boulder_1">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material></visual>
      </link>
    </model>
 
    <model name="boulder_2">
      <static>true</static>
      <pose>-2 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material></visual>
      </link>
    </model>
 
    <model name="boulder_3">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>1.5</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material></visual>
      </link>
    </model>
 
    <model name="inner_wall">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 6 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 6 1</size></box></geometry>
          <material><ambient>0.6 0.3 0.25 1</ambient><diffuse>0.6 0.3 0.25 1</diffuse></material></visual>
      </link>
    </model>
 
    <!-- ================= Vehicle ================= -->
    <!-- Spawned by sim.launch.py -->
  </world>
</sdf>
